# Application Settings
ENV=development
PORT=8000
IP_ADDRESS=127.0.0.1

APP_TITLE="Enterprise CRM Backend"
APP_DESCRIPTION="High-performance, asynchronous REST API services built with FastAPI, SQLAlchemy 2.0, and Pydantic v2."
APP_VERSION=1.0.0

# Database Settings
# Note: For asyncpg connection, use postgresql+asyncpg:// scheme
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Security & JWT Authentication Settings
JWT_SECRET_KEY=dev-fallback-secret-never-use-in-prod-123456789
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=1h
SALT_ROUNDS=12
JWT_COOKIE_NAME=access_token

# Mail Parameters (SMTP Settings)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=False
MAIL_FROM=

# Cookie configuration
COOKIE_NAME=access_token
COOKIE_MAX_AGE=3600
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
COOKIE_SAME_SITE=

# Default Admin Credentials
ADMIN_ID=userId
ADMIN_NAME="User Name"
ADMIN_MAIL="admin@example.com"
ADMIN_PASSWORD=password
